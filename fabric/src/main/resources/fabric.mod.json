{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${mod_version}",
  "accessWidener": "${mod_id}.accesswidener",
  "name": "${mod_display_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "contact": {
    "homepage": "${mod_url}",
    "sources": "${mod_source}",
    "issues": "${mod_issue_tracker}"
  },
  "license": "${mod_license}",
  "icon": "assets/${mod_id}/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.tiviacz.warriorrage.fabric.WarriorRageFabric"
    ],
    "client": [
      "com.tiviacz.warriorrage.fabric.WarriorRageFabricClient"
    ]
  },
  "mixins": [
    "${mod_id}.mixins.json"
  ],
  "depends": {
    "fabricloader": "${fabric_loader_dep}",
    "fabric": "${fabric_api_dep}",
    "minecraft": "${minecraft_dep}",
    "java": "${java_dep}",
    "forgeconfigapiport": "${forgeconfigapiport_dep}"
  }
}